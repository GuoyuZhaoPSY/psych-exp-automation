{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/psych-exp-automation/experiment_spec.schema.json",
  "title": "ExperimentSpec",
  "description": "General psychology experiment specification. The schema is intentionally paradigm-neutral: experiments are expressed as phases, blocks, trials, and events.",
  "type": "object",
  "required": ["version", "metadata", "runtime", "target_platform", "design", "timing", "trial_structure", "blocks", "data", "output"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Spec version, e.g. 0.1.0."
    },
    "metadata": {
      "type": "object",
      "required": ["experiment_id", "title"],
      "properties": {
        "experiment_id": { "type": "string" },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "paradigm_reference": {
          "type": "string",
          "description": "Optional reference label only. It must not constrain generation."
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": {
          "type": "string",
          "description": "Natural language used in the running experiment, e.g. zh-CN or en-US."
        },
        "continue_key": { "type": "string" },
        "welcome_text": { "type": "string" },
        "end_text": { "type": "string" },
        "continue_text": { "type": "string" }
      }
    },
    "target_platform": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {
          "enum": ["psychopy", "psychtoolbox"]
        },
        "supported": {
          "type": "array",
          "items": { "enum": ["psychopy", "psychtoolbox"] }
        }
      }
    },
    "design": {
      "type": "object",
      "required": ["design_type", "independent_variables", "dependent_variables"],
      "properties": {
        "design_type": { "type": "string" },
        "independent_variables": { "type": "array" },
        "dependent_variables": { "type": "array" },
        "counterbalancing": { "type": "string" },
        "randomization": { "type": "string" }
      }
    },
    "conditions": {
      "type": "array",
      "description": "Trial-level condition rows. They may be generated by scripts later, but inline rows keep early examples inspectable."
    },
    "timing": {
      "type": "object",
      "properties": {
        "control": {
          "enum": ["frame"],
          "description": "Timing control mode. v0.1 requires frame-level timing for generated experiment code."
        },
        "frame_rate_fallback_hz": { "type": "number" },
        "duration_rounding": { "enum": ["nearest_frame"] }
      }
    },
    "trial_structure": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": {
                "enum": ["instruction", "text", "keyboard_response", "feedback", "blank"]
              },
              "content": {},
              "color": {},
              "duration_ms": {},
              "max_duration_ms": {},
              "choices": {},
              "correct_key": {},
              "response_ends_trial": { "type": "boolean" },
              "record_response": { "type": "boolean" },
              "show_when": { "type": "string" }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "trials"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "instruction": { "type": "string" },
          "feedback": { "type": "boolean" },
          "trials": {
            "type": "object",
            "required": ["source", "order", "repetitions"],
            "properties": {
              "source": { "type": "string" },
              "order": { "enum": ["fixed", "random"] },
              "repetitions": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["format", "directory", "filename_template"],
      "properties": {
        "format": { "enum": ["csv"] },
        "directory": { "type": "string" },
        "filename_template": { "type": "string" }
      }
    }
  }
}
